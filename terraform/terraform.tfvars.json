{
  "bucket_name": "testing123-mario-bucket56",
  "lifecycle_rules": [
    {
      "id": "abc-12345",
      "enabled": true,
      "prefix": "logs/",
      "transition_days": 30,
      "transition_storage_class": "STANDARD_IA",
      "expiration_days": 30,
      "noncurrent_version_expiration_days": 30
    }
  ],
  "cors_rules": [
    {
      "allowed_headers": [
        "*"
      ],
      "allowed_methods": [
        "GET",
        "PUT"
      ],
      "allowed_origins": [
        "https://example.com"
      ],
      "expose_headers": [
        "*"
      ],
      "max_age_seconds": 3600
    }
  ]
}