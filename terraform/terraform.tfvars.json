{
  "bucket_name": "testing-weorewior-234",
  "cors_rules": [
    {
      "allowed_headers": [
        "*"
      ],
      "allowed_methods": [
        "GET",
        "PUT",
        "POST"
      ],
      "allowed_origins": [
        "https://yourdomain.com"
      ],
      "expose_headers": [
        "ETag"
      ],
      "max_age_seconds": 3600
    }
  ],
  "lifecycle_rules": [
    {
      "id": "archive-old-objects",
      "enabled": true,
      "prefix": "",
      "transition_days": 30,
      "transition_storage_class": "STANDARD_IA",
      "expiration_days": 365,
      "noncurrent_version_expiration_days": 90
    }
  ]
}